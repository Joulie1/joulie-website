<div class="page-title">
  <h1>Kontakt</h1>
  <p class="lead">Ich freue mich auf deine Nachricht.</p>
  <hr class="divider">
</div>
<form class="contact-form" action="mailto:kontakt@example.com" method="post" enctype="text/plain">
  <label>Name
    <input type="text" name="name" required>
  </label>
  <label>E-Mail
    <input type="email" name="email" required>
  </label>
  <label>Nachricht
    <textarea name="nachricht" rows="6" required></textarea>
  </label>
  <button class="button" type="submit">Senden</button>
</form>
