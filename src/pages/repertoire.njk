---
slug: "repertoire.html"
titleKey: repertoire.title
permalink: "/{{ language.code }}/repertoire.html"
---
{%- set lang = language.code -%}
<div class="page-title">
  <h1>{{ "repertoire.title" | t(lang) }}</h1>
  <p class="lead">{{ "repertoire.lead" | t(lang) }}</p>
  <hr class="divider">
</div>
<section class="text-block">
  <ul class="repertoire-list">
    {%- for i in range(1, 17) %}
    <li>{{ "repertoire.item" | t(lang) }} {{ i }} – {{ "repertoire.artist" | t(lang) }}</li>
    {%- endfor %}
  </ul>
</section>
